test("Investment records a 3-year principal lock", async () => {
  const {
    investor,
    mockUsdt,
    central,
  } = await setup();

  const amount = 1_000n * 10n ** 18n;

  await mockUsdt.write.mint([
    investor.account.address,
    amount,
  ]);

  await mockUsdt.write.approve(
    [central.address, amount],
    { account: investor.account }
  );

  const before = BigInt(Math.floor(Date.now() / 1000));

  await central.write.invest(
    [amount],
    { account: investor.account }
  );

  const investments = await central.read.getInvestments([
    investor.account.address,
  ]);

  const investment = investments[0];

  const after = BigInt(Math.floor(Date.now() / 1000));

  const lockDuration = 1095n * 24n * 60n * 60n;

  const expectedMinimum = before + lockDuration - 60n;
  const expectedMaximum = after + lockDuration + 60n;

  assert.equal(investment.amount, amount);

  assert.ok(
    investment.unlockTime >= expectedMinimum
  );

  assert.ok(
    investment.unlockTime <= expectedMaximum
  );
});

test("Repayment is blocked before the 3-year principal unlock", async () => {
  const {
    owner,
    investor,
    mockUsdt,
    central,
  } = await setup();

  const amount = 1_000n * 10n ** 18n;

  await mockUsdt.write.mint([
    investor.account.address,
    amount,
  ]);

  await mockUsdt.write.approve(
    [central.address, amount],
    { account: investor.account }
  );

  await central.write.invest(
    [amount],
    { account: investor.account }
  );

  const investments = await central.read.getInvestments([
    investor.account.address,
  ]);

  const investment = investments[0];

  assert.ok(investment.unlockTime > 0n);

  await assert.rejects(
    central.write.repayPrincipal(
      [investor.account.address, 0n],
      { account: owner.account }
    )
  );
});
