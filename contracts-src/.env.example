# Copy this file to ".env" (never share or commit .env)
# Wallet that pays the gas for deployment (needs about 0.01 BNB). Use a fresh wallet just for deploying.
DEPLOYER_PRIVATE_KEY=
# The wallet that will CONTROL the contract and open /admin. Address only. Hardware wallet or Safe is best.
OWNER_ADDRESS=
# Optional: your own BSC RPC URL
BSC_RPC_URL=
