# Public site configuration (safe to expose to the browser)
NEXT_PUBLIC_SITE_URL=https://www.oxyloan.io
NEXT_PUBLIC_SITE_NAME=OxyLoan

# Social / external links
NEXT_PUBLIC_TWITTER_URL=https://twitter.com/oxyloan
NEXT_PUBLIC_TELEGRAM_URL=https://t.me/oxyloan
NEXT_PUBLIC_DISCORD_URL=https://discord.gg/oxyloan
NEXT_PUBLIC_GITHUB_URL=https://github.com/oxyloan
NEXT_PUBLIC_MEDIUM_URL=https://medium.com/@oxyloan

# Contract / chain info (placeholders — replace with real deployed values)
NEXT_PUBLIC_TOKEN_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_CHAIN_NAME=Ethereum

# Contact form endpoint (e.g. a Formspree/Resend endpoint). Never put API keys
# with write access to sensitive data in NEXT_PUBLIC_ vars — use a server
# route (src/app/api/contact) and keep secret keys server-only, e.g.:
# CONTACT_API_KEY=replace_me_in_your_local_env_only
