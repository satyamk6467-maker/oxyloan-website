# ---------- PUBLIC (safe to expose in the browser) ----------
# Free project id from https://cloud.reown.com  (needed for the wallet pop-up)
NEXT_PUBLIC_REOWN_PROJECT_ID=
# Address of the deployed OxyloanInvest contract on BNB Smart Chain
NEXT_PUBLIC_INVEST_CONTRACT=
# Optional: your own BSC RPC (NodeReal / Ankr / QuickNode) for reads in the browser
NEXT_PUBLIC_BSC_RPC=
NEXT_PUBLIC_SITE_URL=https://oxylon.vercel.app

# ---------- SECRET (set ONLY in Vercel project settings, never commit) ----------
# Server-side RPC for verifying transactions
BSC_RPC_URL=https://bsc-dataseed.bnbchain.org
# Supabase: Project settings -> API -> service_role key (server only!)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# The ONLY wallet that may open /admin (use your hardware wallet / Safe)
ADMIN_ADDRESS=
# Random 64+ char strings:  openssl rand -hex 48
SESSION_SECRET=
CRON_SECRET=
# Optional, recommended for strict rate limiting across all servers (free tier at upstash.com)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Block number the contract was deployed at (indexer starts here)
INVEST_CONTRACT_DEPLOY_BLOCK=
